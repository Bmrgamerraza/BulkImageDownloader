---
// src/pages/webpage-image-scraper.astro
import Layout from "../layouts/Layout.astro";
import Downloader from "../components/Downloader.astro";
import Features from "../components/Features.astro";
import HowToUse from "../components/HowToUse.astro";
---

<Layout
  title="Webpage Image Scraper - Extract & Download All Images from Website"
  description="Scrape and download all images from any webpage. Enter a website URL to extract image elements, CSS backgrounds, and responsive srcsets. Free & secure."
  keywords="webpage image scraper, extract images from webpage, download all images from website, website image downloader, scrape images from site"
>
  <!-- Hero Section -->
  <section
    class="relative overflow-hidden pt-12 pb-20 border-b border-hairline bg-canvas rounded-lg mb-12"
  >
    <div
      class="absolute inset-0 -top-40 -left-40 h-[600px] w-[800px] mesh-gradient pointer-events-none"
    >
    </div>
    <div
      class="absolute right-0 top-0 h-[500px] w-[500px] mesh-gradient pointer-events-none"
      style="opacity: 0.08;"
    >
    </div>

    <div class="relative z-10 max-w-3xl mx-auto text-center px-4">
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-link-bg-soft px-3 py-1 text-xs font-semibold text-link mb-6"
      >
        ⚡ Webpage Scraper & Crawler
      </span>
      <h1
        class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-ink mb-6 font-sans"
      >
        Extract and download website images.
      </h1>
      <p
        class="text-lg md:text-xl text-body mb-8 leading-relaxed max-w-2xl mx-auto"
      >
        Enter any public website URL. Our crawler will instantly search for and
        extract all images, icons, backgrounds, and responsive assets for easy packaging.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="#downloader"
          class="rounded-pill bg-primary px-6 py-3 text-sm font-medium text-on-primary hover:bg-neutral-800 transition-colors shadow-sm"
        >
          Open Webpage Scraper
        </a>
      </div>
    </div>
  </section>

  <!-- Downloader Workspace (Scraper tab active by default) -->
  <Downloader defaultTab="scraper" />

  <!-- Features Grid -->
  <Features />

  <!-- How to Use Workflow -->
  <HowToUse />

  <!-- Dedicated SEO Copy for Webpage Image Scrapers -->
  <section
    id="seo-guide"
    class="max-w-[1000px] mx-auto border-t border-hairline pt-20 mb-20 scroll-mt-20"
  >
    <div class="bg-canvas border border-hairline rounded-lg p-6 sm:p-8 md:p-12 shadow-sm">
      <h2 class="text-3xl font-bold tracking-tight text-ink mb-6 font-sans border-b border-hairline pb-4">
        How the Webpage Image Scraper and Extractor Works
      </h2>
      
      <div class="prose max-w-none text-sm text-body leading-relaxed space-y-6">
        <p>
          Whether you are a developer backing up a theme, a designer gathering visual references, or a content creator migrating articles to a new CMS, downloading website assets one by one is exhausting. A <strong>webpage image scraper</strong> automate this crawling process.
        </p>

        <p>
          When you enter a website URL into our extractor, a server-side parser crawls the HTML markup of the target page and resolves every possible image location.
        </p>

        <h3 class="text-xl font-bold text-ink mt-8 mb-4 font-sans">
          What Types of Image Assets Can We Extract?
        </h3>
        
        <p>
          Unlike simple downloaders that only look for the <code>src</code> attribute on basic image tags, our advanced crawler analyzes multiple layers of page markup:
        </p>
        
        <ul class="list-disc pl-5 space-y-2">
          <li>
            <strong>Standard Image Tags</strong>: Scrapes classic <code>&lt;img src="..."&gt;</code> elements and their <code>alt</code> tags.
          </li>
          <li>
            <strong>Responsive Source Sets</strong>: Analyzes <code>srcset</code> attributes on both <code>&lt;img&gt;</code> and <code>&lt;source&gt;</code> elements inside <code>&lt;picture&gt;</code> tags. This ensures you can access the highest resolution version available.
          </li>
          <li>
            <strong>CSS Background Declarations</strong>: Crawls inline styles for background image declarations like <code>style="background-image: url(...)"</code>.
          </li>
          <li>
            <strong>Linked Image Anchors</strong>: Identifies links <code>&lt;a href="..."&gt;</code> that point directly to image file extensions (PNG, JPG, SVG, WebP), allowing you to extract high-resolution gallery targets.
          </li>
        </ul>

        <h3 class="text-xl font-bold text-ink mt-8 mb-4 font-sans">
          Webpage Image Scraper vs. Browser Extensions
        </h3>
        
        <p>
          Many searchers default to looking for browser extensions. However, a web-based <strong>website image downloader</strong> has unique benefits:
        </p>
        
        <ol class="list-decimal pl-5 space-y-2">
          <li>
            <strong>No Installation & Safety</strong>: Browser extensions run with elevated permissions that can read and write all your private browser data, which can lead to adware hijacking. Our tool is sandboxed and runs in a standard web tab.
          </li>
          <li>
            <strong>Platform Independence</strong>: Extensions are restricted to specific desktop browsers (Chrome, Firefox, Edge). Our web scraper runs on Safari, iOS, Android, ChromeOS, and Linux.
          </li>
          <li>
            <strong>Server-Side Bypassing</strong>: Standard browser javascript running inside a website cannot access images on other domains due to CORS rules. Our backend API acts as a secure intermediary to fetch target page HTML code.
          </li>
        </ol>

        <h3 class="text-xl font-bold text-ink mt-8 mb-4 font-sans">
          Best Practices for Scraping Images Responsibly
        </h3>
        
        <p>
          When using our <strong>extract images from webpage</strong> tool, keep the following ethical and legal considerations in mind:
        </p>
        
        <ul class="list-disc pl-5 space-y-2">
          <li>
            <strong>Copyright Ownership</strong>: Just because an image can be scraped does not mean you own it. Respect copyright licenses (Creative Commons, commercial, etc.) before using images for public or commercial purposes.
          </li>
          <li>
            <strong>Robots.txt Constraints</strong>: We respect website crawl rules. Ensure you are scraping public assets that are not hidden behind paywalls or authorization screens.
          </li>
          <li>
            <strong>Bandwidth Conservation</strong>: Our backend limits rapid crawl requests to protect target host servers from DDoS or performance degradation.
          </li>
        </ul>
      </div>

      <div class="mt-12 border-t border-hairline pt-8">
        <h3 class="text-2xl font-bold text-ink mb-6 font-sans">
          Frequently Asked Questions (Webpage Scraper)
        </h3>
        <div class="space-y-6">
          <div class="border-b border-hairline pb-4">
            <h4 class="text-base font-semibold text-ink mb-2">
              Why did the scraper fail to find images on a webpage?
            </h4>
            <p class="text-sm text-body leading-relaxed">
              This usually happens if the website is a Single Page Application (SPA) that requires JavaScript execution to render image content, or if the page is behind a login wall/CAPTCHA blocker. Our crawler reads static HTML markup.
            </p>
          </div>
          <div class="border-b border-hairline pb-4">
            <h4 class="text-base font-semibold text-ink mb-2">
              Does the webpage scraper support relative image paths?
            </h4>
            <p class="text-sm text-body leading-relaxed">
              Yes. Our scraping API automatically extracts the base URL of the target website and converts all relative paths (e.g. <code>/assets/logo.png</code>) into absolute URLs (e.g. <code>https://example.com/assets/logo.png</code>) so they download successfully.
            </p>
          </div>
          <div class="border-b border-hairline pb-4">
            <h4 class="text-base font-semibold text-ink mb-2">
              Can I scrape files from a private, local address (localhost)?
            </h4>
            <p class="text-sm text-body leading-relaxed">
              No. Because the initial page parsing is performed by our server crawler, the target URL must be publicly accessible on the internet. Local servers (like localhost or private intranet sites) cannot be crawled.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Structured FAQ Schema for SEO Rich Snippets -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why did the scraper fail to find images on a webpage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "This usually happens if the website is a Single Page Application (SPA) that requires JavaScript execution to render image content, or if the page is behind a login wall/CAPTCHA blocker. Our crawler reads static HTML markup."
          }
        },
        {
          "@type": "Question",
          "name": "Does the webpage scraper support relative image paths?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Our scraping API automatically extracts the base URL of the target website and converts all relative paths (e.g. /assets/logo.png) into absolute URLs (e.g. https://example.com/assets/logo.png) so they download successfully."
          }
        },
        {
          "@type": "Question",
          "name": "Can I scrape files from a private, local address (localhost)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Because the initial page parsing is performed by our server crawler, the target URL must be publicly accessible on the internet. Local servers (like localhost or private intranet sites) cannot be crawled."
          }
        }
      ]
    }
  </script>
</Layout>
