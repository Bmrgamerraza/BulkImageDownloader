---
// src/pages/[lang]/contact.astro
import Layout from "../../layouts/Layout.astro";
import { subpageGeneralContent } from "../../i18n/content";
import { supportedLanguages, type SupportedLanguage } from "../../i18n/ui";

export const prerender = false;

const { lang } = Astro.params;

if (!lang || !supportedLanguages.includes(lang as SupportedLanguage) || lang === "en") {
  return Astro.redirect("/404");
}

const currentLang = lang as SupportedLanguage;
const content = subpageGeneralContent[currentLang]?.contact || subpageGeneralContent.en.contact;
---

<Layout
  title={content.title}
  description={content.description}
  lang={currentLang}
>
  <!-- Hero Section -->
  <section
    class="relative overflow-hidden pt-12 pb-20 border-b border-hairline bg-canvas rounded-lg mb-12"
  >
    <div
      class="absolute inset-0 -top-40 -left-40 h-[600px] w-[800px] mesh-gradient pointer-events-none"
    >
    </div>
    <div
      class="absolute right-0 top-0 h-[500px] w-[500px] mesh-gradient pointer-events-none"
      style="opacity: 0.08;"
    >
    </div>

    <div class="relative z-10 max-w-3xl mx-auto text-center px-4">
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-link-bg-soft px-3 py-1 text-xs font-semibold text-link mb-6"
      >
        {content.badge}
      </span>
      <h1
        class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-ink mb-6 font-sans"
      >
        {content.heroTitle}
      </h1>
      <p
        class="text-lg md:text-xl text-body mb-8 leading-relaxed max-w-2xl mx-auto"
      >
        {content.heroSubtitle}
      </p>
    </div>
  </section>

  <!-- Contact Info Grid -->
  <section class="max-w-[900px] mx-auto mb-20 px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
      <!-- Direct Contact Card -->
      <div
        class="bg-canvas border border-hairline rounded-lg p-8 shadow-sm flex flex-col justify-between transition-all hover:shadow-md hover:border-link/30"
      >
        <div>
          <div
            class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-link-bg-soft text-link text-xl mb-6"
          >
            ✉️
          </div>
          <h2
            class="text-xl sm:text-2xl font-bold tracking-tight text-ink mb-3 font-sans"
          >
            {content.directTitle}
          </h2>
          <p class="text-sm text-body leading-relaxed mb-6">
            {content.directDesc}
          </p>
        </div>
        <a
          href="mailto:contact@bulkimagedownloader.co"
          class="inline-flex items-center gap-2 font-mono text-sm font-semibold text-link hover:underline break-all"
        >
          contact@bulkimagedownloader.co
          <svg
            class="w-4 h-4 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            />
          </svg>
        </a>
      </div>

      <!-- FAQ Card -->
      <div
        class="bg-canvas border border-hairline rounded-lg p-8 shadow-sm flex flex-col justify-between transition-all hover:shadow-md hover:border-link/30"
      >
        <div>
          <div
            class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-violet-soft text-violet-deep text-xl mb-6"
          >
            ❓
          </div>
          <h2
            class="text-xl sm:text-2xl font-bold tracking-tight text-ink mb-3 font-sans"
          >
            {content.faqTitle}
          </h2>
          <p class="text-sm text-body leading-relaxed mb-6">
            {content.faqDesc}
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
