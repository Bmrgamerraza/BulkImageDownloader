---
// src/pages/[lang]/index.astro
import Layout from "../../layouts/Layout.astro";
import Downloader from "../../components/Downloader.astro";
import Features from "../../components/Features.astro";
import HowToUse from "../../components/HowToUse.astro";
import { homeContent } from "../../i18n/content";
import { supportedLanguages, type SupportedLanguage } from "../../i18n/ui";

export const prerender = false;

const { lang } = Astro.params;

if (!lang || !supportedLanguages.includes(lang as SupportedLanguage) || lang === "en") {
  return Astro.redirect("/404");
}

const currentLang = lang as SupportedLanguage;
const content = homeContent[currentLang] || homeContent.en;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title={content.seo.title}
  description={content.seo.description}
  keywords={content.seo.keywords}
  lang={currentLang}
>
  <!-- Hero Section with Decorative Atmospheric Mesh Gradient -->
  <section
    class="relative overflow-hidden pt-12 pb-20 border-b border-hairline bg-canvas rounded-lg mb-12"
  >
    <!-- Mesh Gradient Backdrop -->
    <div
      class="absolute inset-0 -top-40 -left-40 h-[600px] w-[800px] mesh-gradient pointer-events-none"
    >
    </div>
    <div
      class="absolute right-0 top-0 h-[500px] w-[500px] mesh-gradient pointer-events-none"
      style="opacity: 0.08;"
    >
    </div>

    <div class="relative z-10 max-w-3xl mx-auto text-center px-4">
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-link-bg-soft px-3 py-1 text-xs font-semibold text-link mb-6"
      >
        {content.seo.badge}
      </span>
      <h1
        class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-ink mb-6 font-sans"
      >
        {content.seo.heroTitle}
      </h1>
      <p
        class="text-lg md:text-xl text-body mb-8 leading-relaxed max-w-2xl mx-auto"
      >
        {content.seo.heroSubtitle}
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="#downloader"
          class="rounded-pill bg-primary px-6 py-3 text-sm font-medium text-on-primary hover:bg-neutral-800 transition-colors shadow-sm"
        >
          {content.seo.primaryCta}
        </a>
        {content.seo.secondaryCta && (
          <a
            href="#features"
            class="rounded-pill border border-hairline bg-canvas px-6 py-3 text-sm font-medium text-body hover:bg-canvas-soft-2 transition-colors"
          >
            {content.seo.secondaryCta}
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Reusable Downloader Component -->
  <Downloader defaultTab="direct" lang={currentLang} />

  <!-- Reusable Features Grid Component -->
  <Features lang={currentLang} />

  <!-- Reusable How To Use Guide Component -->
  <HowToUse lang={currentLang} />

  <!-- Comprehensive SEO Guide Section -->
  <section
    id="seo-guide"
    class="max-w-[1000px] mx-auto border-t border-hairline pt-20 mb-20 scroll-mt-20"
  >
    <div
      class="bg-canvas border border-hairline rounded-lg p-6 sm:p-8 md:p-12 shadow-sm"
    >
      <h2
        class="text-3xl font-bold tracking-tight text-ink mb-6 font-sans border-b border-hairline pb-4"
      >
        {content.guideTitle}
      </h2>

      <div class="prose max-w-none text-sm text-body leading-relaxed space-y-6">
        {
          content.guideParagraphs.map((para) => (
            <div>
              {para.heading && (
                <h3 class="text-xl font-bold text-ink mt-8 mb-4 font-sans">
                  {para.heading}
                </h3>
              )}
              <p>{para.text}</p>
              {para.list && (
                <ul class="list-disc pl-5 space-y-2 mt-3">
                  {para.list.map((item) => (
                    <li set:html={item} />
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>

      <div class="mt-12 border-t border-hairline pt-8">
        <h3 class="text-2xl font-bold text-ink mb-6 font-sans">
          {content.faqTitle}
        </h3>
        <div class="space-y-4">
          {
            content.faqs.map((faq, index) => (
              <details class="group border-b border-hairline pb-4" open={index === 0}>
                <summary class="flex justify-between items-center text-base font-semibold text-ink cursor-pointer list-none select-none hover:text-primary transition-colors py-2">
                  <span>{faq.question}</span>
                  <svg
                    class="h-5 w-5 text-mute group-open:-rotate-180 transition-transform duration-200"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>
                <div class="mt-2 text-sm text-body leading-relaxed pl-1 space-y-2">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Structured FAQ Schema for SEO Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <style>
    summary::-webkit-details-marker {
      display: none;
    }
    summary {
      list-style: none;
    }
  </style>
</Layout>
