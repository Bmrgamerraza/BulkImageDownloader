---
// src/pages/contact.astro
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Us - Bulk Image Downloader Support"
  description="Have feedback, feature requests, or questions? Contact us at our support email and our team will get in touch with you shortly."
  keywords="contact bulk image downloader, downloader support, image scraper feedback"
>
  <!-- Hero Section -->
  <section
    class="relative overflow-hidden pt-12 pb-20 border-b border-hairline bg-canvas rounded-lg mb-12"
  >
    <div
      class="absolute inset-0 -top-40 -left-40 h-[600px] w-[800px] mesh-gradient pointer-events-none"
    >
    </div>
    <div
      class="absolute right-0 top-0 h-[500px] w-[500px] mesh-gradient pointer-events-none"
      style="opacity: 0.08;"
    >
    </div>

    <div class="relative z-10 max-w-3xl mx-auto text-center px-4">
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-link-bg-soft px-3 py-1 text-xs font-semibold text-link mb-6"
      >
        ✉️ Get in Touch
      </span>
      <h1
        class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-ink mb-6 font-sans"
      >
        Contact Us
      </h1>
      <p
        class="text-lg md:text-xl text-body mb-8 leading-relaxed max-w-2xl mx-auto"
      >
        Have questions, feedback, or custom feature requests? Reach out to us via email and our support team will assist you.
      </p>
    </div>
  </section>

  <!-- Contact Info Grid -->
  <section class="max-w-[900px] mx-auto mb-20 px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
      <!-- Direct Contact Card -->
      <div class="bg-canvas border border-hairline rounded-lg p-8 shadow-sm flex flex-col justify-between transition-all hover:shadow-md hover:border-link/30">
        <div>
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-link-bg-soft text-link text-xl mb-6">
            ✉️
          </div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-ink mb-3 font-sans">
            Direct Contact
          </h2>
          <p class="text-sm text-body leading-relaxed mb-6">
            For business inquiries, partnership proposals, general feedback, or direct support, please email us directly:
          </p>
        </div>
        <a
          href="mailto:support@freebulkimagedownloader.com"
          class="inline-flex h-12 items-center justify-center rounded-sm bg-link-bg-soft text-sm font-semibold text-link hover:bg-link-bg-soft-2 hover:underline transition-colors px-4 py-2 text-center break-all"
        >
          support@freebulkimagedownloader.com
        </a>
      </div>

      <!-- Technical Support Card -->
      <div class="bg-canvas border border-hairline rounded-lg p-8 shadow-sm flex flex-col justify-between transition-all hover:shadow-md hover:border-success/30">
        <div>
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-success/10 text-success text-xl mb-6">
            🛠️
          </div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-ink mb-3 font-sans">
            Technical Support
          </h2>
          <p class="text-sm text-body leading-relaxed mb-6">
            Encountered an issue scraping a specific website? Let us know the URL and details via email, and our team will refine our parser selectors!
          </p>
        </div>
        <div class="flex items-center justify-between border-t border-hairline pt-4 mt-auto">
          <span class="text-xs font-semibold text-mute uppercase tracking-wider">Service Status</span>
          <div class="flex items-center gap-2 text-xs font-semibold text-success bg-success/10 rounded-full px-3 py-1">
            <span class="inline-block w-2 h-2 rounded-full bg-success animate-pulse"></span>
            Stateless proxy active
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
