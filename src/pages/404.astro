---
// src/pages/404.astro
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found (404) - Free Bulk Image Downloader"
  description="The page you are looking for does not exist. Return to Free Bulk Image Downloader to download images in bulk from URL lists or webpages."
  keywords="404, page not found, bulk image downloader"
>
  <div class="relative overflow-hidden pt-16 pb-24 border border-hairline bg-canvas rounded-lg mb-12 flex flex-col items-center justify-center text-center min-h-[60vh] px-4">
    <!-- Mesh Gradient Backdrop -->
    <div
      class="absolute inset-0 -top-40 -left-40 h-[600px] w-[800px] mesh-gradient pointer-events-none"
    >
    </div>
    <div
      class="absolute right-0 bottom-0 h-[500px] w-[500px] mesh-gradient pointer-events-none"
      style="opacity: 0.08;"
    >
    </div>

    <div class="relative z-10 max-w-2xl mx-auto flex flex-col items-center">
      <!-- Status Badge -->
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-error-soft px-3.5 py-1 text-xs font-semibold text-error-deep mb-6"
      >
        🔍 Error 404
      </span>

      <!-- 404 Title Graphic -->
      <h1
        class="text-7xl sm:text-8xl md:text-9xl font-extrabold tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-primary via-ink to-body select-none leading-none mb-4 animate-pulse"
      >
        404
      </h1>

      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink mb-4 font-sans">
        Oops! Page not found
      </h2>
      
      <p class="text-base text-body mb-8 leading-relaxed max-w-md">
        We couldn't find the page you were looking for. It might have been moved, deleted, or the URL might have a typo.
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <a
          href="/"
          class="rounded-pill bg-primary px-6 py-2.5 text-sm font-semibold text-on-primary hover:bg-neutral-800 transition-colors shadow-sm cursor-pointer"
        >
          Go Back Home
        </a>
        <button
          onclick="window.history.back()"
          class="rounded-pill border border-hairline bg-canvas px-6 py-2.5 text-sm font-medium text-body hover:bg-canvas-soft-2 transition-colors cursor-pointer"
        >
          Go Back
        </button>
      </div>

      <!-- Quick Navigation Grid -->
      <div class="w-full border-t border-hairline pt-10">
        <h3 class="text-xs font-mono font-semibold tracking-wider text-mute uppercase mb-6">
          Or try one of our tools
        </h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left w-full max-w-xl">
          <a
            href="/url-list-downloader"
            class="group p-4 bg-canvas border border-hairline rounded-md hover:border-hairline-strong transition-all flex flex-col gap-1"
          >
            <span class="text-sm font-semibold text-ink group-hover:text-link transition-colors flex items-center gap-1.5">
              🔗 URL List Downloader <span class="opacity-0 group-hover:opacity-100 transition-opacity">&rarr;</span>
            </span>
            <span class="text-xs text-mute leading-relaxed">
              Paste image URLs and download them in a single click.
            </span>
          </a>

          <a
            href="/webpage-image-scraper"
            class="group p-4 bg-canvas border border-hairline rounded-md hover:border-hairline-strong transition-all flex flex-col gap-1"
          >
            <span class="text-sm font-semibold text-ink group-hover:text-link transition-colors flex items-center gap-1.5">
              🕸️ Webpage Image Scraper <span class="opacity-0 group-hover:opacity-100 transition-opacity">&rarr;</span>
            </span>
            <span class="text-xs text-mute leading-relaxed">
              Extract and grab all images from any website URL.
            </span>
          </a>

          <a
            href="/chrome-extension-alternative"
            class="group p-4 bg-canvas border border-hairline rounded-md hover:border-hairline-strong transition-all flex flex-col gap-1"
          >
            <span class="text-sm font-semibold text-ink group-hover:text-link transition-colors flex items-center gap-1.5">
              💻 Chrome Alternative <span class="opacity-0 group-hover:opacity-100 transition-opacity">&rarr;</span>
            </span>
            <span class="text-xs text-mute leading-relaxed">
              A private, developer-centric alternative to Chrome extensions.
            </span>
          </a>

          <a
            href="/about"
            class="group p-4 bg-canvas border border-hairline rounded-md hover:border-hairline-strong transition-all flex flex-col gap-1"
          >
            <span class="text-sm font-semibold text-ink group-hover:text-link transition-colors flex items-center gap-1.5">
              ℹ️ About the Downloader <span class="opacity-0 group-hover:opacity-100 transition-opacity">&rarr;</span>
            </span>
            <span class="text-xs text-mute leading-relaxed">
              Read about our client-side philosophy and privacy features.
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
