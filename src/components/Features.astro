---
// src/components/Features.astro
import { getLangFromUrl } from "../i18n/utils";
import { homeContent } from "../i18n/content";
import type { SupportedLanguage } from "../i18n/ui";

interface Props {
  lang?: SupportedLanguage;
}

const currentUrlLang = getLangFromUrl(Astro.url);
const { lang = currentUrlLang } = Astro.props;

const content = homeContent[lang] || homeContent.en;
const features = content.features;
---

<!-- Detailed Feature Sections (Vercel-Inspired Layout) -->
<section
  id="features"
  class="max-w-[1200px] mx-auto border-t border-hairline pt-20 mb-16 scroll-mt-20"
>
  <div class="text-center max-w-2xl mx-auto mb-16">
    <span
      class="font-mono text-xs text-mute font-semibold uppercase tracking-wider mb-3 block"
      >{content.featuresSubtitle}</span
    >
    <h2 class="text-3xl font-bold tracking-tight text-ink mb-4 font-sans">
      {content.featuresTitle}
    </h2>
    <p class="text-sm text-body leading-relaxed">
      {content.featuresDesc}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      features.map((feature) => (
        <div class="bg-canvas border border-hairline rounded-lg p-5 sm:p-6 shadow-sm hover:shadow-md transition-shadow">
          <div
            class={`h-10 w-10 flex items-center justify-center rounded-sm text-lg font-bold mb-4 ${feature.badgeBg} ${feature.badgeColor}`}
          >
            {feature.icon}
          </div>
          <h3 class="text-lg font-bold text-ink mb-2">
            {feature.title}
          </h3>
          <p class="text-sm text-body leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))
    }
  </div>
</section>
