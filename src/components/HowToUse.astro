---
// src/components/HowToUse.astro
import { getLangFromUrl } from "../i18n/utils";
import { homeContent } from "../i18n/content";
import type { SupportedLanguage } from "../i18n/ui";

interface Props {
  lang?: SupportedLanguage;
}

const currentUrlLang = getLangFromUrl(Astro.url);
const { lang = currentUrlLang } = Astro.props;

const content = homeContent[lang] || homeContent.en;
const steps = content.steps;
---

<!-- Step by Step How to Use -->
<section
  id="how-to-use"
  class="max-w-[800px] mx-auto border-t border-hairline pt-20 mb-20 scroll-mt-20"
>
  <div class="text-center mb-12">
    <span
      class="font-mono text-xs text-mute font-semibold uppercase tracking-wider mb-3 block"
      >{content.howToSubtitle}</span
    >
    <h2 class="text-3xl font-bold tracking-tight text-ink font-sans">
      {content.howToTitle}
    </h2>
  </div>

  <ol class="space-y-6">
    {
      steps.map((step) => (
        <li class="flex gap-4 items-start bg-canvas border border-hairline rounded-md p-4 sm:p-6 shadow-sm">
          <span class="h-8 w-8 shrink-0 flex items-center justify-center rounded-full bg-primary text-sm font-bold text-on-primary">
            {step.number}
          </span>
          <div>
            <h4 class="text-base font-semibold text-ink mb-1">
              {step.title}
            </h4>
            <p class="text-sm text-body leading-relaxed">
              {step.description}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
